# Pin the public npm registry so a stray proxy/mirror can't slow installs down.
registry=https://registry.npmjs.org/

# Faster, quieter installs.
fund=false
audit=false
# Give slow/cold connections more room before npm gives up and retries.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Reproducible, exact versions in package-lock.json.
save-exact=true

# Show progress so you can tell it's working, not hung.
progress=true
